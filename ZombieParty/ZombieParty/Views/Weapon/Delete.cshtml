@model ZombieParty.Models.Weapon

<h2>Delete Weapon</h2>

<h4>Are you sure you want to delete this weapon?</h4>

<p>Name: @Model.Name</p>

<form asp-action="Delete" method="post">

    <input type="hidden" name="id" value="@Model.WeaponId" />

    <button type="submit" class="btn btn-danger">
        <i class="fa-solid fa-trash"></i> Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>